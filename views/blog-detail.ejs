<%- include('partials/header') %>

<style>
  /* Markdown Content Styling */
  .prose-content {
    color: #cbd5e1;
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .prose-content h1, .prose-content h2, .prose-content h3, .prose-content h4 {
    color: #ffffff;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .prose-content h1 { font-size: 2rem; }
  .prose-content h2 { font-size: 1.6rem; border-bottom: 1px solid #334155; padding-bottom: 0.5rem; }
  .prose-content h3 { font-size: 1.3rem; }
  .prose-content p { margin-bottom: 1.25rem; }
  .prose-content ul, .prose-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .prose-content ul { list-style-type: disc; }
  .prose-content ol { list-style-type: decimal; }
  .prose-content li { margin-bottom: 0.5rem; }
  .prose-content code {
    background-color: #1e293b;
    color: #a5b4fc;
    padding: 0.2rem 0.4rem;
    border-radius: 0.375rem;
    font-size: 0.9em;
    font-family: monospace;
  }
  .prose-content pre {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 0.75rem;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }
  .prose-content pre code {
    background: transparent;
    padding: 0;
    color: #e2e8f0;
  }
  .prose-content blockquote {
    border-left: 4px solid #6366f1;
    padding-left: 1rem;
    font-style: italic;
    color: #94a3b8;
    margin: 1.5rem 0;
  }
  .prose-content strong { color: #f8fafc; }
  .prose-content a { color: #818cf8; text-decoration: underline; }
  .prose-content a:hover { color: #a5b4fc; }
</style>

<main class="py-12 flex-1">
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb & Back Link -->
    <div class="mb-8 flex items-center justify-between text-xs text-slate-400">
      <a href="/blog" class="inline-flex items-center gap-2 hover:text-indigo-400 transition font-medium">
        <i class="fa-solid fa-arrow-left text-xs"></i>
        <span>Kembali ke Semua Artikel</span>
      </a>
      <span><%= blog.read_time || '3 min read' %></span>
    </div>

    <!-- Article Header -->
    <header class="mb-8">
      <div class="flex items-center gap-3 text-xs text-slate-400 mb-4">
        <span class="px-2.5 py-1 rounded bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 font-semibold">
          Artikel Blog
        </span>
        <span>•</span>
        <span><%= new Date(blog.created_at).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
        <%= blog.title %>
      </h1>

      <p class="text-lg text-slate-300 leading-relaxed font-normal mb-8">
        <%= blog.excerpt %>
      </p>

      <!-- Tags list -->
      <div class="flex flex-wrap gap-2 pb-6 border-b border-slate-800">
        <% (blog.tags || '').split(',').forEach(tag => { %>
          <a href="/blog?tag=<%= encodeURIComponent(tag.trim()) %>" class="text-xs px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-indigo-300 transition">
            #<%= tag.trim() %>
          </a>
        <% }) %>
      </div>
    </header>

    <!-- Cover Image -->
    <% if (blog.cover_image) { %>
      <div class="mb-10 rounded-2xl overflow-hidden shadow-2xl border border-slate-800 bg-slate-900 max-h-[450px]">
        <img 
          src="<%= blog.cover_image %>" 
          alt="<%= blog.title %>" 
          class="w-full h-full object-cover"
          onerror="this.style.display='none'"
        >
      </div>
    <% } %>

    <!-- Markdown Rendered Body -->
    <div class="prose-content bg-slate-900/40 border border-slate-800/80 p-6 sm:p-10 rounded-2xl mb-12">
      <%- htmlContent %>
    </div>

    <!-- Author Profile Card -->
    <div class="p-6 sm:p-8 rounded-2xl bg-slate-900 border border-slate-800 flex flex-col sm:flex-row items-center sm:items-start gap-6 mb-16">
      <img 
        src="<%= settings.avatar_url || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80' %>" 
        alt="<%= settings.owner_name %>" 
        class="w-20 h-20 rounded-2xl object-cover border border-slate-700 shadow-md"
        onerror="this.src='https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=600&q=80'"
      >
      <div class="space-y-2 text-center sm:text-left flex-1">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h4 class="text-base font-bold text-white"><%= settings.owner_name || 'Farhan Ale' %></h4>
            <p class="text-xs text-indigo-400"><%= settings.tagline || 'Network Engineer & Security Engineer' %></p>
          </div>
          <a href="/contact" class="px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold transition self-center sm:self-auto">
            Hubungi Penulis
          </a>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          <%= settings.bio || 'Pengembang web yang berdedikasi menciptakan karya digital berkualitas tinggi.' %>
        </p>
      </div>
    </div>

    <!-- Related Blogs -->
    <% if (relatedBlogs && relatedBlogs.length > 0) { %>
      <div class="border-t border-slate-800 pt-12">
        <h3 class="text-xl font-bold text-white mb-6">Artikel Terkait Lainnya</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <% relatedBlogs.forEach(rel => { %>
            <a href="/blog/<%= rel.slug %>" class="group p-5 rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition flex flex-col justify-between">
              <div>
                <span class="text-[11px] text-slate-400"><%= rel.read_time %></span>
                <h4 class="text-base font-bold text-white group-hover:text-indigo-400 transition mt-1 line-clamp-2">
                  <%= rel.title %>
                </h4>
                <p class="text-xs text-slate-400 mt-2 line-clamp-2">
                  <%= rel.excerpt %>
                </p>
              </div>
              <span class="mt-4 text-xs font-semibold text-indigo-400 flex items-center gap-1">
                <span>Baca artikel</span>
                <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

  </article>
</main>

<%- include('partials/footer') %>
