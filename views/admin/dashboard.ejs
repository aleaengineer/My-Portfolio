<%- include('../partials/admin-header') %>

<div class="space-y-8">
  
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Dashboard Ringkasan</h1>
      <p class="text-slate-400 text-xs sm:text-sm mt-1">
        Selamat datang kembali, <strong class="text-indigo-400"><%= adminUsername %></strong>! Pantau dan kelola konten portofolio Anda di sini.
      </p>
    </div>
    
    <div class="flex items-center gap-2">
      <a href="/admin/projects/new" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition flex items-center gap-1.5 shadow-md shadow-indigo-600/20">
        <i class="fa-solid fa-plus text-[10px]"></i> Tambah Proyek
      </a>
      <a href="/admin/blogs/new" class="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs transition flex items-center gap-1.5 shadow-md shadow-purple-600/20">
        <i class="fa-solid fa-pen text-[10px]"></i> Tulis Artikel
      </a>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    
    <!-- Stat 1: Projects -->
    <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-between shadow-lg">
      <div>
        <span class="text-xs uppercase font-bold text-slate-400 tracking-wider">Total Proyek</span>
        <h3 class="text-3xl font-extrabold text-white mt-1"><%= stats.projects %></h3>
        <a href="/admin/projects" class="text-xs text-indigo-400 hover:text-indigo-300 font-medium mt-2 inline-block">Kelola proyek →</a>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 flex items-center justify-center text-xl">
        <i class="fa-solid fa-folder-tree"></i>
      </div>
    </div>

    <!-- Stat 2: Blogs -->
    <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-between shadow-lg">
      <div>
        <span class="text-xs uppercase font-bold text-slate-400 tracking-wider">Total Artikel</span>
        <h3 class="text-3xl font-extrabold text-white mt-1"><%= stats.blogs %></h3>
        <a href="/admin/blogs" class="text-xs text-purple-400 hover:text-purple-300 font-medium mt-2 inline-block">Kelola artikel →</a>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-purple-500/10 text-purple-400 border border-purple-500/20 flex items-center justify-center text-xl">
        <i class="fa-solid fa-newspaper"></i>
      </div>
    </div>

    <!-- Stat 3: Total Messages -->
    <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-between shadow-lg">
      <div>
        <span class="text-xs uppercase font-bold text-slate-400 tracking-wider">Total Pesan</span>
        <h3 class="text-3xl font-extrabold text-white mt-1"><%= stats.totalMessages %></h3>
        <a href="/admin/messages" class="text-xs text-blue-400 hover:text-blue-300 font-medium mt-2 inline-block">Buka inbox pesan →</a>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-blue-500/10 text-blue-400 border border-blue-500/20 flex items-center justify-center text-xl">
        <i class="fa-solid fa-inbox"></i>
      </div>
    </div>

    <!-- Stat 4: Unread Messages -->
    <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-between shadow-lg">
      <div>
        <span class="text-xs uppercase font-bold text-slate-400 tracking-wider">Pesan Baru</span>
        <h3 class="text-3xl font-extrabold text-white mt-1"><%= stats.unreadMessages %></h3>
        <span class="text-xs text-slate-400 mt-2 inline-block">Belum dibaca</span>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center justify-center text-xl relative">
        <i class="fa-solid fa-envelope"></i>
        <% if (stats.unreadMessages > 0) { %>
          <span class="absolute -top-1 -right-1 w-3.5 h-3.5 rounded-full bg-rose-500 border-2 border-slate-900"></span>
        <% } %>
      </div>
    </div>

  </div>

  <!-- 2 Columns: Recent Messages & Recent Projects -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Recent Messages (7 cols) -->
    <div class="lg:col-span-7 bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
      <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
        <div>
          <h2 class="text-lg font-bold text-white">Pesan Masuk Terbaru</h2>
          <p class="text-xs text-slate-400 mt-0.5">Pesan yang dikirimkan oleh pengunjung melalui formulir kontak</p>
        </div>
        <a href="/admin/messages" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300">
          Lihat Semua (<%= stats.totalMessages %>)
        </a>
      </div>

      <% if (recentMessages.length === 0) { %>
        <div class="text-center py-12 text-slate-500 text-xs">
          <i class="fa-regular fa-envelope-open text-3xl mb-2 block text-slate-600"></i>
          Belum ada pesan yang masuk.
        </div>
      <% } else { %>
        <div class="space-y-3">
          <% recentMessages.forEach(msg => { %>
            <div class="p-4 rounded-xl border <%= msg.is_read ? 'bg-slate-950/40 border-slate-800/80' : 'bg-slate-800/40 border-indigo-500/30' %> transition">
              <div class="flex items-start justify-between gap-3 mb-2">
                <div>
                  <span class="font-bold text-sm text-white"><%= msg.name %></span>
                  <span class="text-xs text-slate-400 ml-2">&lt;<%= msg.email %>&gt;</span>
                </div>
                <div class="flex items-center gap-2">
                  <% if (!msg.is_read) { %>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">Baru</span>
                  <% } %>
                  <span class="text-[11px] text-slate-500">
                    <%= new Date(msg.created_at).toLocaleDateString('id-ID', { month: 'short', day: 'numeric' }) %>
                  </span>
                </div>
              </div>

              <div class="text-xs font-semibold text-slate-200 mb-1">
                Subjek: <%= msg.subject %>
              </div>

              <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed mb-3">
                <%= msg.message %>
              </p>

              <div class="flex items-center justify-between text-xs pt-2 border-t border-slate-800/60">
                <a href="mailto:<%= msg.email %>?subject=Re: <%= encodeURIComponent(msg.subject) %>" class="text-indigo-400 hover:text-indigo-300 inline-flex items-center gap-1">
                  <i class="fa-solid fa-reply text-[10px]"></i> Balas via Email
                </a>
                
                <div class="flex items-center gap-2">
                  <% if (!msg.is_read) { %>
                    <form action="/admin/messages/read/<%= msg.id %>" method="POST" class="inline">
                      <button type="submit" class="text-slate-400 hover:text-emerald-400 transition" title="Tandai sudah dibaca">
                        <i class="fa-solid fa-check text-xs"></i> Tandai Dibaca
                      </button>
                    </form>
                  <% } %>
                  <form action="/admin/messages/delete/<%= msg.id %>" method="POST" class="inline" onsubmit="return confirm('Hapus pesan ini?')">
                    <button type="submit" class="text-slate-400 hover:text-rose-400 transition" title="Hapus pesan">
                      <i class="fa-solid fa-trash text-xs"></i>
                    </button>
                  </form>
                </div>
              </div>

            </div>
          <% }) %>
        </div>
      <% } %>

    </div>

    <!-- Recent Projects & Shortcuts (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Recent Projects -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-800">
          <h2 class="text-lg font-bold text-white">Proyek Terakhir</h2>
          <a href="/admin/projects" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300">
            Kelola Semua
          </a>
        </div>

        <div class="space-y-3">
          <% recentProjects.forEach(proj => { %>
            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950/60 border border-slate-800">
              <div class="flex items-center gap-3">
                <img 
                  src="<%= proj.image_url || 'https://images.unsplash.com/photo-1557821552-17105176677c?auto=format&fit=crop&w=800&q=80' %>" 
                  alt="" 
                  class="w-10 h-10 rounded-lg object-cover bg-slate-800"
                  onerror="this.src='https://images.unsplash.com/photo-1557821552-17105176677c?auto=format&fit=crop&w=800&q=80'"
                >
                <div>
                  <h4 class="text-xs font-bold text-white line-clamp-1"><%= proj.title %></h4>
                  <span class="text-[10px] text-slate-400"><%= proj.category %></span>
                </div>
              </div>
              <a href="/admin/projects/edit/<%= proj.id %>" class="px-2.5 py-1 rounded bg-slate-800 text-slate-300 hover:text-white text-xs transition">
                <i class="fa-solid fa-pen-to-square text-[10px]"></i> Edit
              </a>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Quick Action Cards -->
      <div class="bg-gradient-to-br from-indigo-950/40 to-purple-950/40 border border-indigo-500/20 rounded-2xl p-6">
        <h3 class="text-sm font-bold text-white mb-2 flex items-center gap-2">
          <i class="fa-solid fa-sliders text-indigo-400"></i> Pengaturan Cepat
        </h3>
        <p class="text-xs text-slate-300 mb-4 leading-relaxed">
          Ubah nama, bio pengembang, daftar keahlian teknologi, dan tautan media sosial Anda dengan mudah.
        </p>
        <a href="/admin/settings" class="inline-block px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold transition shadow-md shadow-indigo-600/30">
          Buka Pengaturan Profil
        </a>
      </div>

    </div>

  </div>

</div>

</main>
</body>
</html>
