<%- include('../partials/admin-header') %>

<div class="space-y-6">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Kotak Pesan Masuk (Kontak)</h1>
      <p class="text-slate-400 text-xs sm:text-sm mt-1">Daftar semua pesan yang dikirimkan oleh pengunjung melalui formulir kontak.</p>
    </div>
  </div>

  <!-- Messages List -->
  <% if (messages.length === 0) { %>
    <div class="text-center py-20 bg-slate-900 border border-slate-800 rounded-2xl shadow-xl">
      <i class="fa-regular fa-envelope-open text-4xl mb-3 block text-slate-600"></i>
      <h3 class="text-base font-bold text-slate-300">Belum Ada Pesan Masuk</h3>
      <p class="text-slate-500 text-xs mt-1">Pesan dari pengunjung melalui formulir kontak akan ditampilkan di sini.</p>
    </div>
  <% } else { %>
    <div class="space-y-4">
      <% messages.forEach(msg => { %>
        <div class="p-6 rounded-2xl border transition <%= msg.is_read ? 'bg-slate-900 border-slate-800' : 'bg-slate-900/90 border-indigo-500/50 shadow-lg shadow-indigo-500/5 ring-1 ring-indigo-500/20' %>">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-slate-800 flex items-center justify-center text-white font-bold text-sm shrink-0">
                <%= msg.name.charAt(0) %>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-base font-bold text-white"><%= msg.name %></h3>
                  <% if (!msg.is_read) { %>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                      Baru (Belum Dibaca)
                    </span>
                  <% } else { %>
                    <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-slate-800 text-slate-400">
                      Sudah Dibaca
                    </span>
                  <% } %>
                </div>
                <a href="mailto:<%= msg.email %>" class="text-xs text-indigo-400 hover:text-indigo-300 transition">
                  <%= msg.email %>
                </a>
              </div>
            </div>

            <div class="text-xs text-slate-400 sm:text-right">
              <i class="fa-regular fa-clock mr-1"></i>
              <%= new Date(msg.created_at).toLocaleDateString('id-ID', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </div>
          </div>

          <!-- Subject -->
          <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 mb-4">
            <div class="text-xs text-slate-400 font-semibold uppercase tracking-wider mb-0.5">Subjek:</div>
            <div class="text-sm font-bold text-slate-200"><%= msg.subject %></div>
          </div>

          <!-- Content Message -->
          <div class="text-sm text-slate-300 leading-relaxed whitespace-pre-line p-4 rounded-xl bg-slate-950 border border-slate-800/60 mb-5">
            <%= msg.message %>
          </div>

          <!-- Footer Actions -->
          <div class="flex items-center justify-between pt-4 border-t border-slate-800">
            <a 
              href="mailto:<%= msg.email %>?subject=Re: <%= encodeURIComponent(msg.subject) %>" 
              class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs shadow-md shadow-indigo-600/20 transition inline-flex items-center gap-1.5"
            >
              <i class="fa-solid fa-reply text-xs"></i>
              <span>Balas ke Email</span>
            </a>

            <div class="flex items-center gap-2">
              <% if (!msg.is_read) { %>
                <form action="/admin/messages/read/<%= msg.id %>" method="POST" class="inline">
                  <button type="submit" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-emerald-400 text-xs font-semibold border border-slate-700 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-check text-xs"></i> Tandai Dibaca
                  </button>
                </form>
              <% } %>
              <form action="/admin/messages/delete/<%= msg.id %>" method="POST" class="inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus pesan ini?')">
                <button type="submit" class="px-3 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 text-xs font-semibold transition flex items-center gap-1.5">
                  <i class="fa-solid fa-trash text-xs"></i> Hapus
                </button>
              </form>
            </div>
          </div>

        </div>
      <% }) %>
    </div>
  <% } %>

</div>

</main>
</body>
</html>
