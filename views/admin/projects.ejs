<%- include('../partials/admin-header') %>

<div class="space-y-6">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Kelola Portofolio Proyek</h1>
      <p class="text-slate-400 text-xs sm:text-sm mt-1">Tambah, edit, atau hapus karya proyek yang ditampilkan di website portofolio Anda.</p>
    </div>
    <a href="/admin/projects/new" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs shadow-md shadow-indigo-600/25 transition">
      <i class="fa-solid fa-plus text-xs"></i>
      <span>Tambah Proyek Baru</span>
    </a>
  </div>

  <!-- Projects Table Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
    
    <% if (projects.length === 0) { %>
      <div class="text-center py-16 text-slate-500 text-sm">
        <i class="fa-solid fa-folder-open text-3xl mb-3 block text-slate-600"></i>
        Belum ada proyek yang ditambahkan.
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="border-b border-slate-800 bg-slate-950/60 text-slate-400 text-xs uppercase font-bold tracking-wider">
              <th class="py-4 px-6">Proyek</th>
              <th class="py-4 px-6">Kategori</th>
              <th class="py-4 px-6">Teknologi</th>
              <th class="py-4 px-6 text-center">Status</th>
              <th class="py-4 px-6 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            <% projects.forEach(p => { %>
              <tr class="hover:bg-slate-800/30 transition">
                <td class="py-4 px-6">
                  <div class="flex items-center gap-3">
                    <img 
                      src="<%= p.image_url || 'https://images.unsplash.com/photo-1557821552-17105176677c?auto=format&fit=crop&w=800&q=80' %>" 
                      alt="" 
                      class="w-12 h-12 rounded-xl object-cover bg-slate-800 border border-slate-700/60 shrink-0"
                      onerror="this.src='https://images.unsplash.com/photo-1557821552-17105176677c?auto=format&fit=crop&w=800&q=80'"
                    >
                    <div>
                      <h4 class="font-bold text-white text-sm"><%= p.title %></h4>
                      <p class="text-slate-400 text-xs line-clamp-1 max-w-xs mt-0.5"><%= p.description %></p>
                    </div>
                  </div>
                </td>
                <td class="py-4 px-6 text-xs text-slate-300 font-medium">
                  <span class="px-2.5 py-1 rounded-lg bg-slate-800 text-slate-300 border border-slate-700">
                    <%= p.category %>
                  </span>
                </td>
                <td class="py-4 px-6 text-xs text-slate-400 font-mono">
                  <%= (p.tags || '').split(',').slice(0, 3).join(', ') %>
                </td>
                <td class="py-4 px-6 text-center">
                  <% if (p.featured) { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">
                      <i class="fa-solid fa-star text-[10px]"></i> Unggulan
                    </span>
                  <% } else { %>
                    <span class="text-xs text-slate-500">Standar</span>
                  <% } %>
                </td>
                <td class="py-4 px-6 text-right">
                  <div class="inline-flex items-center gap-2">
                    <a href="/admin/projects/edit/<%= p.id %>" class="px-3 py-1.5 rounded-lg bg-indigo-500/10 text-indigo-400 hover:bg-indigo-500/20 border border-indigo-500/30 text-xs font-semibold transition" title="Edit Proyek">
                      <i class="fa-solid fa-pen-to-square mr-1"></i> Edit
                    </a>
                    <form action="/admin/projects/delete/<%= p.id %>" method="POST" class="inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus proyek ini?')">
                      <button type="submit" class="p-1.5 rounded-lg bg-rose-500/10 text-rose-400 hover:bg-rose-500/20 border border-rose-500/30 text-xs transition" title="Hapus Proyek">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

  </div>

</div>

</main>
</body>
</html>
