<%- include('../partials/admin-header') %>

<div class="space-y-6">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Kelola Artikel Blog</h1>
      <p class="text-slate-400 text-xs sm:text-sm mt-1">Tulis, perbarui, atau atur publikasi tulisan blog dan tutorial Anda.</p>
    </div>
    <a href="/admin/blogs/new" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs shadow-md shadow-purple-600/25 transition">
      <i class="fa-solid fa-pen-nib text-xs"></i>
      <span>Tulis Artikel Baru</span>
    </a>
  </div>

  <!-- Blogs Table Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
    
    <% if (blogs.length === 0) { %>
      <div class="text-center py-16 text-slate-500 text-sm">
        <i class="fa-solid fa-newspaper text-3xl mb-3 block text-slate-600"></i>
        Belum ada artikel yang dibuat.
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="border-b border-slate-800 bg-slate-950/60 text-slate-400 text-xs uppercase font-bold tracking-wider">
              <th class="py-4 px-6">Artikel</th>
              <th class="py-4 px-6">Waktu Baca</th>
              <th class="py-4 px-6">Tanggal Rilis</th>
              <th class="py-4 px-6 text-center">Status</th>
              <th class="py-4 px-6 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            <% blogs.forEach(b => { %>
              <tr class="hover:bg-slate-800/30 transition">
                <td class="py-4 px-6">
                  <div class="flex items-center gap-3">
                    <img 
                      src="<%= b.cover_image || 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=800&q=80' %>" 
                      alt="" 
                      class="w-12 h-12 rounded-xl object-cover bg-slate-800 border border-slate-700/60 shrink-0"
                      onerror="this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=800&q=80'"
                    >
                    <div>
                      <h4 class="font-bold text-white text-sm line-clamp-1"><%= b.title %></h4>
                      <span class="text-slate-400 text-xs font-mono">/blog/<%= b.slug %></span>
                    </div>
                  </div>
                </td>
                <td class="py-4 px-6 text-xs text-slate-300">
                  <i class="fa-regular fa-clock mr-1 text-slate-500"></i> <%= b.read_time || '3 min read' %>
                </td>
                <td class="py-4 px-6 text-xs text-slate-400">
                  <%= new Date(b.created_at).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </td>
                <td class="py-4 px-6 text-center">
                  <% if (b.published) { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-500/10 text-emerald-300 border border-emerald-500/30">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Publik
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-800 text-slate-400 border border-slate-700">
                      Draft
                    </span>
                  <% } %>
                </td>
                <td class="py-4 px-6 text-right">
                  <div class="inline-flex items-center gap-2">
                    <a href="/blog/<%= b.slug %>" target="_blank" class="p-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white text-xs transition" title="Lihat di Web">
                      <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </a>
                    <a href="/admin/blogs/edit/<%= b.id %>" class="px-3 py-1.5 rounded-lg bg-purple-500/10 text-purple-400 hover:bg-purple-500/20 border border-purple-500/30 text-xs font-semibold transition" title="Edit Artikel">
                      <i class="fa-solid fa-pen mr-1"></i> Edit
                    </a>
                    <form action="/admin/blogs/delete/<%= b.id %>" method="POST" class="inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus artikel ini?')">
                      <button type="submit" class="p-1.5 rounded-lg bg-rose-500/10 text-rose-400 hover:bg-rose-500/20 border border-rose-500/30 text-xs transition" title="Hapus Artikel">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

  </div>

</div>

</main>
</body>
</html>
