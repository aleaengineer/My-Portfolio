<%- include('../partials/admin-header') %>

<div class="max-w-4xl mx-auto space-y-6">
  
  <!-- Header -->
  <div class="flex items-center justify-between pb-4 border-b border-slate-800">
    <div>
      <h1 class="text-2xl font-extrabold text-white"><%= isEdit ? 'Edit Artikel Blog' : 'Tulis Artikel Baru' %></h1>
      <p class="text-slate-400 text-xs mt-1">Gunakan format teks Markdown untuk penulisan artikel yang kaya dan terstruktur.</p>
    </div>
    <a href="/admin/blogs" class="text-xs text-slate-400 hover:text-white transition flex items-center gap-1.5">
      <i class="fa-solid fa-arrow-left text-[10px]"></i> Kembali ke Daftar
    </a>
  </div>

  <!-- Form Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl">
    <form action="<%= isEdit ? '/admin/blogs/edit/' + blog.id : '/admin/blogs/new' %>" method="POST" class="space-y-6">
      
      <!-- Title -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Judul Artikel *</label>
        <input 
          type="text" 
          name="title" 
          required 
          value="<%= isEdit ? blog.title : '' %>"
          placeholder="Contoh: Panduan Menguasai Backend dengan Node.js"
          class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition text-sm font-medium"
        >
      </div>

      <!-- Slug & Read Time -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Slug URL (Opsional)</label>
          <input 
            type="text" 
            name="slug" 
            value="<%= isEdit ? blog.slug : '' %>"
            placeholder="panduan-menguasai-backend (otomatis jika kosong)"
            class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition text-sm font-mono text-xs"
          >
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Perkiraan Waktu Baca</label>
          <input 
            type="text" 
            name="read_time" 
            value="<%= isEdit ? blog.read_time : '3 min read' %>"
            placeholder="Contoh: 4 min read"
            class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition text-sm"
          >
        </div>
      </div>

      <!-- Excerpt -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Ringkasan / Excerpt *</label>
        <textarea 
          name="excerpt" 
          rows="2" 
          required 
          placeholder="Ringkasan singkat 1-2 kalimat yang menarik minat pembaca..."
          class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition text-sm"
        ><%= isEdit ? blog.excerpt : '' %></textarea>
      </div>

      <!-- Content Markdown -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="text-xs font-semibold uppercase tracking-wider text-slate-300">Isi Konten (Markdown) *</label>
          <span class="text-[11px] text-indigo-400 font-mono">Dukungan: # Header, **Tebal**, \`code\`, - List</span>
        </div>
        <textarea 
          name="content" 
          rows="12" 
          required 
          placeholder="Tuliskan isi artikel Anda di sini menggunakan format Markdown...

## Judul Bagian
Paragraf penjelasan artikel.

### Sub-bagian
- Poin penting 1
- Poin penting 2

\`\`\`javascript
console.log('Contoh kode program');
\`\`\`"
          class="w-full p-4 rounded-xl bg-slate-950 border border-slate-800 text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition text-sm font-mono leading-relaxed"
        ><%= isEdit ? blog.content : '' %></textarea>
      </div>

      <!-- Cover Image & Tags -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">URL Gambar Sampul (Cover Image)</label>
          <input 
            type="url" 
            name="cover_image" 
            value="<%= isEdit ? blog.cover_image : '' %>"
            placeholder="https://images.unsplash.com/..."
            class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition text-sm"
          >
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Tags (Pisahkan Koma)</label>
          <input 
            type="text" 
            name="tags" 
            value="<%= isEdit ? blog.tags : '' %>"
            placeholder="Node.js, Express, Tutorial, Web"
            class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition text-sm"
          >
        </div>
      </div>

      <!-- Published Toggle -->
      <div class="pt-2">
        <label class="inline-flex items-center gap-3 cursor-pointer">
          <input 
            type="checkbox" 
            name="published" 
            value="1" 
            <%= (!isEdit || blog.published) ? 'checked' : '' %>
            class="w-5 h-5 rounded bg-slate-950 border-slate-800 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-slate-900"
          >
          <span class="text-sm font-medium text-slate-200">
            Publikasikan langsung ke publik (jika tidak dicentang akan disimpan sebagai Draft)
          </span>
        </label>
      </div>

      <!-- Action Buttons -->
      <div class="pt-6 border-t border-slate-800 flex items-center justify-end gap-3">
        <a href="/admin/blogs" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs transition">
          Batal
        </a>
        <button 
          type="submit" 
          class="px-6 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs shadow-md shadow-purple-600/30 transition flex items-center gap-1.5"
        >
          <i class="fa-solid fa-floppy-disk text-xs"></i>
          <span><%= isEdit ? 'Simpan Perubahan' : 'Terbitkan Artikel' %></span>
        </button>
      </div>

    </form>
  </div>

</div>

</main>
</body>
</html>
