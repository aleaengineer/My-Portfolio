  <!-- Footer -->
  <footer class="mt-auto border-t border-slate-800 bg-slate-900/40 text-slate-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
        
        <!-- About Col -->
        <div class="md:col-span-2 space-y-4">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-indigo-600 to-purple-600 flex items-center justify-center text-white font-bold text-sm">
              <%= (settings.owner_name || 'F').charAt(0) %>
            </div>
            <span class="font-bold text-white text-base"><%= settings.owner_name || 'Farhan Ale' %></span>
          </div>
          <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
            <%= settings.tagline || 'Network Engineer & Security Engineer' %>
          </p>
          <p class="text-xs text-slate-500">
            <i class="fa-solid fa-location-dot mr-1.5 text-indigo-400"></i> <%= settings.location || 'Indonesia' %>
          </p>
        </div>

        <!-- Quick Links -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Navigasi</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/" class="hover:text-indigo-400 transition">Beranda</a></li>
            <li><a href="/projects" class="hover:text-indigo-400 transition">Portofolio Proyek</a></li>
            <li><a href="/blog" class="hover:text-indigo-400 transition">Artikel & Catatan</a></li>
            <li><a href="/contact" class="hover:text-indigo-400 transition">Hubungi Saya</a></li>
          </ul>
        </div>

        <!-- Social Media Links -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Media Sosial</h4>
          <div class="flex flex-wrap gap-2 pt-1">
            <% if (settings.github_url) { %>
              <a href="<%= settings.github_url %>" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition border border-slate-700/60 shadow-sm" title="GitHub">
                <i class="fa-brands fa-github text-base"></i>
              </a>
            <% } %>
            <% if (settings.linkedin_url) { %>
              <a href="<%= settings.linkedin_url %>" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition border border-slate-700/60 shadow-sm" title="LinkedIn">
                <i class="fa-brands fa-linkedin text-base text-blue-400"></i>
              </a>
            <% } %>
            <% if (settings.twitter_url) { %>
              <a href="<%= settings.twitter_url %>" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition border border-slate-700/60 shadow-sm" title="Twitter / X">
                <i class="fa-brands fa-x-twitter text-base"></i>
              </a>
            <% } %>
            <% if (settings.email) { %>
              <a href="mailto:<%= settings.email %>" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition border border-slate-700/60 shadow-sm" title="Email">
                <i class="fa-solid fa-envelope text-base text-emerald-400"></i>
              </a>
            <% } %>
          </div>
          <div class="pt-2">
            <a href="/admin/login" class="text-xs text-slate-500 hover:text-indigo-400 transition inline-flex items-center gap-1">
              <i class="fa-solid fa-lock text-[10px]"></i> Portal Admin
            </a>
          </div>
        </div>

      </div>

      <div class="border-t border-slate-800/80 pt-8 text-center text-xs text-slate-500">
        <p>© <%= new Date().getFullYear() %> <%= settings.owner_name || 'Farhan Ale' %>. Hak Cipta Dilindungi.</p>
      </div>
    </div>
  </footer>

</body>
</html>
