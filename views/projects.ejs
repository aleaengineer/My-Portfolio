<%- include('partials/header') %>

<main class="py-16 flex-1">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header Page -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs uppercase font-extrabold tracking-widest text-indigo-400">Portofolio & Karya</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-2">Daftar Proyek</h1>
      <p class="text-slate-400 text-sm mt-3 leading-relaxed">
        Kumpulan proyek yang telah saya kembangkan, mencakup aplikasi web dinamis, sistem antarmuka responsif, dan dashboard analisis.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-8">
        <% categories.forEach(cat => { %>
          <a 
            href="/projects<%= cat === 'Semua' ? '' : '?category=' + encodeURIComponent(cat) %>" 
            class="px-4 py-2 rounded-xl text-xs font-semibold transition border <%= selectedCategory === cat ? 'bg-indigo-600 text-white border-indigo-500 shadow-md shadow-indigo-600/25' : 'bg-slate-900 text-slate-300 border-slate-800 hover:border-slate-700 hover:text-white' %>"
          >
            <%= cat %>
          </a>
        <% }) %>
      </div>
    </div>

    <!-- Projects Grid -->
    <% if (projects.length === 0) { %>
      <div class="text-center py-20 bg-slate-900/50 rounded-3xl border border-slate-800">
        <i class="fa-solid fa-folder-open text-4xl text-slate-600 mb-4 block"></i>
        <h3 class="text-lg font-bold text-slate-300">Belum Ada Proyek</h3>
        <p class="text-slate-500 text-sm mt-1">Tidak ada proyek dalam kategori ini saat ini.</p>
        <a href="/projects" class="mt-4 inline-block px-4 py-2 rounded-xl bg-slate-800 text-slate-300 text-xs font-semibold hover:bg-slate-700 transition">
          Reset Filter Kategori
        </a>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% projects.forEach(project => { %>
          <div class="group bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden hover:border-slate-700 transition duration-300 flex flex-col shadow-lg hover:shadow-indigo-500/10 hover:-translate-y-1">
            <!-- Project Cover Image -->
            <div class="relative h-52 overflow-hidden bg-slate-800">
              <img 
                src="<%= project.image_url || 'https://images.unsplash.com/photo-1557821552-17105176677c?auto=format&fit=crop&w=800&q=80' %>" 
                alt="<%= project.title %>" 
                class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                onerror="this.src='https://images.unsplash.com/photo-1557821552-17105176677c?auto=format&fit=crop&w=800&q=80'"
              >
              <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-semibold bg-slate-950/80 backdrop-blur text-indigo-300 border border-indigo-500/30">
                <%= project.category %>
              </span>
              <% if (project.featured) { %>
                <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/20 backdrop-blur text-amber-300 border border-amber-500/30 flex items-center gap-1">
                  <i class="fa-solid fa-star text-[10px]"></i> Unggulan
                </span>
              <% } %>
            </div>

            <!-- Project Body -->
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-xl font-bold text-white group-hover:text-indigo-400 transition">
                  <%= project.title %>
                </h3>
                <p class="text-slate-400 text-sm mt-3 leading-relaxed">
                  <%= project.description %>
                </p>
              </div>

              <div class="pt-6 mt-6 border-t border-slate-800 flex items-center justify-between">
                <!-- Tags -->
                <div class="flex flex-wrap gap-1.5">
                  <% (project.tags || '').split(',').slice(0, 3).forEach(tag => { %>
                    <span class="text-[11px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">
                      <%= tag.trim() %>
                    </span>
                  <% }) %>
                </div>

                <!-- Links -->
                <div class="flex items-center gap-2">
                  <% if (project.github_url) { %>
                    <a href="<%= project.github_url %>" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition" title="Kode Sumber GitHub">
                      <i class="fa-brands fa-github text-sm"></i>
                    </a>
                  <% } %>
                  <% if (project.demo_url) { %>
                    <a href="<%= project.demo_url %>" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-indigo-600/30 hover:bg-indigo-600 text-indigo-300 hover:text-white flex items-center justify-center transition" title="Live Demo">
                      <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                    </a>
                  <% } %>
                </div>
              </div>

            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </div>
</main>

<%- include('partials/footer') %>
